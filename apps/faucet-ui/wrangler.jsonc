{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "faucet-ui",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2025-08-07",
	"compatibility_flags": ["nodejs_compat"], //Optional
	"routes": [
		{
			"pattern": "faucet.zeko.io",
			"custom_domain": true
		}
	],
	"preview_urls": true,
	"workers_dev": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"assets": {
		"directory": "./.output/public/",
		"binding": "ASSETS"
	},
	"secrets": {
		"required": ["TURNSTILE_SECRET_KEY"]
	},
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"services": [
		{
			"binding": "FAUCET",
			"service": "faucet"
		},
		{
			"binding": "FAUCET_RPC",
			"service": "faucet",
			"entrypoint": "TurnstileClaimsEntrypoint"
		}
	]
}
