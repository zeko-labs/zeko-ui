{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-04-08",
	"name": "faucet",
	"main": "worker.ts",
	"routes": [
		{
			"pattern": "api.faucet.zeko.io",
			"custom_domain": true
		}
	],
	"preview_urls": true,
	"workers_dev": false,
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"secrets": {
		"required": ["ZEKO_FAUCET_SENDER_PRIVATE_KEY"]
	},
	"vars": {
		"ZEKO_FAUCET_SEND_AMOUNT": "10000000000",
		"SPAM_THRESHOLD": "12",
		"SPAM_WINDOW_SECONDS": "3600",
		"BAN_TTL_SECONDS": "86400"
	},
	"kv_namespaces": [
		{
			"binding": "FAUCET_CLAIM",
			"id": "02e09bc705f04bcf9123fb617cc221b1"
		},
		{
			"binding": "FAUCET_BANNED_IPS",
			"id": "4b154f86de1c428e8589d303ece2ff8f",
			"remote": true
		},
		{
			"binding": "FAUCET_IP_SPAM",
			"id": "fa73ffb7eff644ab87929dbfa9479884",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMIT_FAUCET",
			"namespace_id": "100",
			"simple": {
				"limit": 3,
				"period": 60
			}
		}
	],
	"containers": [
		{
			"max_instances": 10,
			"name": "faucet-container",
			"class_name": "Faucet",
			"image": "./Dockerfile",
			"instance_type": "standard",
			"image_build_context": "../.."
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "FAUCET",
				"class_name": "Faucet"
			},
			{
				"name": "CLAIM_MUTEX",
				"class_name": "ClaimMutex"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Faucet"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ClaimMutex"]
		}
	]
}
