{
	"name": "@zeko-ui/webapp",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "dprint fmt --verbose",
		"build": "nuxt build",
		"build:cf": "NITRO_PRESET=cloudflare_module nuxt build",
		"build:netlify": "NITRO_PRESET=netlify_edge nuxt build",
		"deploy": "wrangler deploy",
		"dev:cf": "wrangler dev .output/server/index.mjs --assets .output/public/",
		"type:cf": "wrangler types",
		"deploy:dev": "rimraf .output .wrangler .nuxt && NITRO_PRESET=cloudflare_module nuxt build && wrangler deploy",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare"
	},
	"dependencies": {
		"@ark-ui/vue": "^5.9.1",
		"@hebilicious/nuxt-switch-match": "^0.1.1",
		"@lumina-dex/sdk": "0.5.0",
		"@nuxt/fonts": "^0.10.2",
		"@unhead/vue": "1.11.19",
		"@unocss/reset": "^0.63.6",
		"@vueuse/core": "^12.7.0",
		"@xstate/vue": "^3.1.4",
		"@zeko/design": "workspace:^",
		"@zeko/layer": "workspace:^",
		"arktype": "^2.1.0",
		"lucide-vue-next": "^0.453.0",
		"nuxt": "3.16.2",
		"vue": "latest",
		"xstate": "^5.19.0"
	},
	"devDependencies": {
		"@aurowallet/mina-provider": "^1.0.6",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^22.14.0",
		"nitro-cloudflare-dev": "^0.2.2",
		"postcss-nesting": "^13.0.1",
		"rimraf": "^6.0.1",
		"wrangler": "4.9.1"
	}
}
