{
	"name": "@zeko-ui/webapp",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "dprint fmt --verbose",
		"build": "nuxt build",
		"build:cf": "NITRO_PRESET=cloudflare_module nuxt build",
		"build:netlify": "NITRO_PRESET=netlify_edge nuxt build",
		"deploy": "wrangler deploy",
		"deploy:pr": "wrangler versions upload",
		"dev:cf": "wrangler dev .output/server/index.mjs --assets .output/public/",
		"type:cf": "wrangler types",
		"deploy:dev": "rimraf .output .wrangler .nuxt && NITRO_PRESET=cloudflare_module nuxt build && wrangler deploy",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare"
	},
	"dependencies": {
		"@ark-ui/vue": "catalog:",
		"@hebilicious/nuxt-switch-match": "catalog:",
		"@nuxt/fonts": "catalog:",
		"@unhead/vue": "catalog:",
		"@unocss/reset": "catalog:",
		"@vueuse/core": "catalog:",
		"@xstate/vue": "catalog:",
		"@zeko/design": "workspace:^",
		"@zeko/layer": "workspace:^",
		"arktype": "^2.1.0",
		"lucide-vue-next": "catalog:",
		"nuxt": "catalog:",
		"vue": "catalog:",
		"xstate": "catalog:"
	},
	"devDependencies": {
		"@aurowallet/mina-provider": "catalog:",
		"@hebilicious/vue-switch-match": "catalog:",
		"@total-typescript/ts-reset": "catalog:",
		"@types/node": "^22.14.0",
		"nitro-cloudflare-dev": "catalog:",
		"postcss-nesting": "catalog:",
		"rimraf": "^6.0.1",
		"wrangler": "catalog:"
	}
}
