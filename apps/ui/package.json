{
	"name": "@zeko-ui/webapp",
	"private": true,
	"type": "module",
	"scripts": {
		"format": "dprint fmt --verbose",
		"build": "nuxt build",
		"build:cf": "NITRO_PRESET=cloudflare_module nuxt build",
		"build:netlify": "NITRO_PRESET=netlify_edge nuxt build",
		"deploy": "wrangler deploy",
		"dev:cf": "wrangler dev .output/server/index.mjs --assets .output/public/",
		"deploy:dev": "rimraf .output .wrangler .nuxt && NITRO_PRESET=cloudflare_module nuxt build && wrangler deploy",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare"
	},
	"dependencies": {
		"@ark-ui/vue": "^4.4.2",
		"@hebilicious/nuxt-switch-match": "^0.1.1",
		"@lumina-dex/sdk": "0.5.0",
		"@nuxt/fonts": "^0.10.2",
		"@pinia/nuxt": "0.9.0",
		"@unhead/vue": "1.11.19",
		"@unocss/reset": "^0.63.6",
		"@urql/exchange-retry": "^1.3.0",
		"@urql/vue": "^1.4.2",
		"@vueuse/core": "^12.7.0",
		"@xstate/vue": "^3.1.4",
		"arktype": "^2.1.0",
		"lucide-vue-next": "^0.453.0",
		"nanoid": "^5.0.9",
		"nuxt": "^3.14.1592",
		"o1js": "2.2.0",
		"pinia": "^2.3.0",
		"vue": "latest",
		"xstate": "^5.19.0"
	},
	"devDependencies": {
		"@aurowallet/mina-provider": "^1.0.6",
		"@gql.tada/vue-support": "^1.0.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"colorjs.io": "^0.5.2",
		"postcss-nesting": "^13.0.1",
		"rimraf": "^6.0.1",
		"wrangler": "^3.110.0"
	}
}