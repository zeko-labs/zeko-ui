{
	"name": "@zeko/sdk",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "unbuild",
		"schema:zeko:get": "bunx get-graphql-schema https://devnet.zeko.io/graphql > ./src/graphql/sequencer.graphql",
		"schema:mina:get": "bunx get-graphql-schema https://api.minascan.io/node/devnet/v1/graphql > ./src/graphql/mina.graphql"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		},
		"./vue": {
			"types": "./dist/vue.d.ts",
			"require": "./dist/vue.cjs",
			"import": "./dist/vue.mjs"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"require": "./dist/react.cjs",
			"import": "./dist/react.mjs"
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@aurowallet/mina-provider": "^1.0.6",
		"@gql.tada/vue-support": "^1.0.1",
		"@urql/exchange-retry": "^1.3.0",
		"@urql/vue": "^1.4.1",
		"@xstate/react": "^4.1.3",
		"@zeko/luminadex-contracts": "workspace:^",
		"comlink": "^4.4.2",
		"gql.tada": "^1.8.9",
		"immer": "^10.1.1",
		"mutative": "^1.0.11",
		"o1js": "^1.8.0",
		"urql": "^4.1.0",
		"vue": "^3.5.11",
		"xstate": "^5.18.2"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"oxc-transform": "^0.30.5",
		"rolldown": "^0.13.2",
		"unbuild": "^2.0.0"
	},
	"peerDependencies": {
		"typescript": "^5.6.3"
	}
}
