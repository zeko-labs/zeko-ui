{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-10-08",
	"name": "leaderboard-admin-ui",
	"main": "worker.ts",
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"routes": [{ "custom_domain": true, "pattern": "admin.leaderboard.zeko.io" }],
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	}
}
