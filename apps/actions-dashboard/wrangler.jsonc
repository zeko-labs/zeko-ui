{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "actions-dashboard",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2025-10-21",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"routes": [
		{
			"pattern": "actions.dashboard.zeko.io",
			"custom_domain": true
		}
	],
	"vars": {
		"SEPOLIA_ACTIONS_INDEXER_URL": "https://sepolia.indexer.actions.zeko.io",
		"SEPOLIA_ACTIONS_API_URL": "https://sepolia.api.actions.zeko.io/graphql",
		"SEPOLIA_L1_ARCHIVE_URL": "https://sepolia-gateway.zeko.io/graphql",
		"SEPOLIA_L2_ARCHIVE_URL": "https://archive.sepolia.zeko.io/graphql",
		"SEPOLIA_L2_DAEMON_URL": "https://sepolia.zeko.io/graphql",
		"SEPOLIA_OUTER_ACTIONS_PUBLIC_KEY": "B62qpggUSofPZcWqtgbmLVnSAzzjAqSXjyckLJaBeGmXiPnc2mGUfhf",
		"SEPOLIA_INNER_ACTIONS_PUBLIC_KEY": "B62qjDedeP9617oTUeN8JGhdiqWg4t64NtQkHaoZB9wyvgSjAyupPU1"
	}
}
