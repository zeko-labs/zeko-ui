{
	"$schema": "../../packages/cloudflare-build-config/schema/workers-build.schema.json",
	"scriptName": "bridge",
	"triggers": [
		{
			"name": "Deploy default branch",
			"deployCommand": "./node_modules/.bin/moon exec --ignore-ci-checks bridge-ui:deploy-testnet",
			"branchIncludes": ["main"],
			"branchExcludes": [],
			"pathIncludes": [
				"apps/bridge-ui/**",
				"packages/bridge-sdk/**",
				"packages/graphql/**",
				"packages/design/**",
				"packages/layer/**"
			],
			"pathExcludes": []
		},
		{
			"name": "Deploy non-production branches",
			"deployCommand": "echo 'Bridge UI preview deploys are disabled until the mainnet/testnet split is reviewed.'",
			"branchIncludes": ["*"],
			"branchExcludes": ["main"],
			"pathIncludes": [
				"apps/bridge-ui/**",
				"packages/bridge-sdk/**",
				"packages/graphql/**",
				"packages/design/**",
				"packages/layer/**"
			],
			"pathExcludes": []
		}
	]
}
