{
	"$schema": "../../packages/cloudflare-build-config/schema/workers-build.schema.json",
	"scriptName": "bridge-testnet",
	"triggerTemplateScriptName": "bridge",
	"pruneScriptNames": ["bridge"],
	"environmentVariables": {
		"CLOUDFLARE_ACCOUNT_ID": {
			"value": "a12d2915bc16ee8550f19399839623f7"
		},
		"SENTRY_AUTH_TOKEN": {
			"valueFromEnv": "SENTRY_AUTH_TOKEN",
			"secret": true
		},
		"SENTRY_DSN_PUBLIC": {
			"valueFromEnv": "SENTRY_DSN_PUBLIC",
			"secret": true
		},
		"SENTRY_ORG": {
			"value": "zeko-labs"
		},
		"SENTRY_PROJECT": {
			"value": "zeko-bridge"
		}
	},
	"buildCommand": "curl -fsSL https://moonrepo.dev/install/proto.sh | bash -s -- 0.55.3 --yes && export PROTO_HOME=\"$HOME/.proto\" && export PATH=\"$PROTO_HOME/bin:$PROTO_HOME/shims:$PATH\" && proto install --yes nu",
	"triggers": [
		{
			"name": "Deploy default branch",
			"deployCommand": "PROTO_HOME=\"$HOME/.proto\" PATH=\"$HOME/.proto/bin:$HOME/.proto/shims:$PATH\" ./node_modules/.bin/moon exec --ignore-ci-checks bridge-ui:deploy-testnet",
			"branchIncludes": ["main"],
			"branchExcludes": [],
			"pathIncludes": [
				".moon/**",
				".prototools",
				"apps/bridge-ui/**",
				"moon.yml",
				"package.json",
				"patches/**",
				"packages/bridge-sdk/**",
				"packages/graphql/**",
				"packages/design/**",
				"packages/layer/**",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			],
			"pathExcludes": []
		},
		{
			"name": "Deploy non-production branches",
			"deployCommand": "PROTO_HOME=\"$HOME/.proto\" PATH=\"$HOME/.proto/bin:$HOME/.proto/shims:$PATH\" ./node_modules/.bin/moon exec --ignore-ci-checks bridge-ui:deploy-preview",
			"branchIncludes": ["*"],
			"branchExcludes": ["main"],
			"pathIncludes": [
				".moon/**",
				".prototools",
				"apps/bridge-ui/**",
				"moon.yml",
				"package.json",
				"patches/**",
				"packages/bridge-sdk/**",
				"packages/graphql/**",
				"packages/design/**",
				"packages/layer/**",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			],
			"pathExcludes": []
		}
	]
}
