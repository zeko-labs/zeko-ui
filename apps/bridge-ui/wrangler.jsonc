{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bridge",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2025-08-07",
	"compatibility_flags": ["nodejs_compat"],
	"preview_urls": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"routes": [
		{
			"pattern": "bridge.zeko.io",
			"custom_domain": true
		}
	],
	"analytics_engine_datasets": [{ "binding": "BRIDGE_METRICS", "dataset": "bridge_metrics" }],
	"vars": {
		"SENTRY_PROJECT_ID": "4510000244326480"
	},
	"env": {
		"testnet": {
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"routes": [
				{
					"pattern": "testnet.bridge.zeko.io",
					"custom_domain": true
				},
				{
					"pattern": "alpha.bridge.zeko.io",
					"custom_domain": true
				}
			],
			"analytics_engine_datasets": [{ "binding": "BRIDGE_METRICS", "dataset": "bridge_metrics" }],
			"vars": {
				"SENTRY_PROJECT_ID": "4510000244326480"
			}
		}
	}
}
