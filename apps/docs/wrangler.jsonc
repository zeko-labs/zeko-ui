{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "zeko-docs",
	"compatibility_date": "2025-01-16",
	"main": "worker.ts",
	"preview_urls": true,
	"routes": [{ "pattern": "docs.zeko.io", "custom_domain": true }],
	"assets": {
		"directory": ".vitepress/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
