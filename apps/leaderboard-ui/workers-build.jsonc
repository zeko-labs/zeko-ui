{
	"$schema": "../../packages/cloudflare-build-config/schema/workers-build.schema.json",
	"scriptName": "leaderboard-ui",
	"triggers": [
		{
			"name": "Deploy default branch",
			"deployCommand": "./node_modules/.bin/moon exec --ignore-ci-checks lb-ui:deploy",
			"branchIncludes": ["main"],
			"branchExcludes": [],
			"pathIncludes": ["apps/leaderboard-ui/**"],
			"pathExcludes": []
		},
		{
			"name": "Deploy non-production branches",
			"deployCommand": "./node_modules/.bin/moon exec --ignore-ci-checks lb-ui:deploy-preview",
			"branchIncludes": ["*"],
			"branchExcludes": ["main"],
			"pathIncludes": ["apps/leaderboard-ui/**"],
			"pathExcludes": []
		}
	]
}
