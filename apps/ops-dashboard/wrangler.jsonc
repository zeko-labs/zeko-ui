{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ops-dashboard",
	"main": "./.output/server/index.mjs",
	"compatibility_date": "2025-10-21",
	"compatibility_flags": ["nodejs_compat"],
	"preview_urls": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"routes": [
		{
			"pattern": "ops.zeko.io",
			"custom_domain": true
		}
	],
	"vars": {
		"MAINNET_ACTIONS_INDEXER_URL": "https://indexer.actions.zeko.io",
		"MAINNET_L1_ARCHIVE_URL": "https://gateway.mina.archive.mainnet.zeko.io",
		"MAINNET_L2_ARCHIVE_URL": "https://archive.mainnet.zeko.io/graphql",
		"MAINNET_L1_DAEMON_URL": "https://gateway.mina.mainnet.zeko.io",
		"MAINNET_L2_DAEMON_URL": "https://mainnet.zeko.io/graphql",
		"TESTNET_ACTIONS_INDEXER_URL": "https://testnet.indexer.actions.zeko.io",
		"TESTNET_L1_ARCHIVE_URL": "https://api.minascan.io/archive/devnet/v1/graphql",
		"TESTNET_L2_ARCHIVE_URL": "https://archive.testnet.zeko.io/graphql",
		"TESTNET_L1_DAEMON_URL": "https://api.minascan.io/node/devnet/v1/graphql",
		"TESTNET_L2_DAEMON_URL": "https://testnet.zeko.io/graphql"
	}
}
