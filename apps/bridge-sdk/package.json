{
    "name": "@zeko/bridge-sdk",
    "version": "1.0.0",
    "description": "Zeko bridge SDK",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "format:fix": "dprint fmt",
        "lint:fix": "biome check --fix --unsafe",
        "schema:zeko:get": "gql-tada generate schema 'https://alphanet.zeko.io/graphql' --output './src/graphql/generated/zeko.graphql'",
        "schema:mina:get": "gql-tada generate schema 'https://api.minascan.io/node/devnet/v1/graphql' --output './src/graphql/generated/mina.graphql'",
        "schema:mina:archive:get": "gql-tada generate schema 'https://api.minascan.io/archive/devnet/v1/graphql' --output './src/graphql/generated/mina-archive.graphql'",
        "schema:get": "bun schema:zeko:get && bun schema:mina:get && bun schema:mina:archive:get",
        "fetchOuterActions": "bun examples/fetchOuterActions.ts",
        "fetchInnerActions": "bun examples/fetchInnerActions.ts",
        "submitDeposit": "bun examples/submitDeposit.ts",
        "finalizeDeposit": "bun examples/finalizeDeposit.ts",
        "submitWithdrawal": "bun examples/submitWithdrawal.ts",
        "finalizeWithdrawal": "bun examples/finalizeWithdrawal.ts"
    },
    "keywords": [
        "typescript",
        "library"
    ],
    "author": "Martin Ondejka <martin.ondejka@zeko.io>",
    "contributors": [
        "Martin Ondejka <martin.ondejka@zeko.io>",
        "Emmanuel Donnet <emmanuel@zeko.io>"
    ],
    "license": "MIT",
    "devDependencies": {
        "@0no-co/graphqlsp": "^1.15.0",
        "@types/node": "^20.8.10",
        "gql.tada": "^1.8.13",
        "prettier": "^3.0.3",
        "typescript": "^5.2.2"
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": ""
    },
    "dependencies": {
        "@urql/exchange-retry": "^1.3.0",
        "o1js": "^2.6.0",
        "urql": "^4.2.2",
        "valibot": "^1.1.0"
    }
}