{
	"servers": {
		"ark-ui": {
			"command": "npx",
			"args": ["-y", "@ark-ui/mcp"]
		},
		"moon": {
			"type": "stdio",
			"command": "moon",
			"args": ["mcp"],
			"env": {
				"MOON_WORKSPACE_ROOT": "${workspaceFolder}"
			}
		},
		"playwright": {
			"command": "npx",
			"args": ["@playwright/mcp@latest"]
		},
		"cloudflare-documentation": {
			"command": "npx",
			"args": ["mcp-remote", "https://docs.mcp.cloudflare.com/sse"]
		}
	}
}
