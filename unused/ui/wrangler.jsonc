{
	"$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
	"name": "website",
	"account_id": "a12d2915bc16ee8550f19399839623f7",
	"compatibility_date": "2025-01-16",
	"compatibility_flags": ["nodejs_compat"], //Optional
	"main": "./.output/server/index.mjs",
	"preview_urls": true,
	"assets": {
		"directory": "./.output/public/",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "zeko.io",
			"custom_domain": true
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "STORE_FAUCET_URL",
			"store_id": "f83375a001d345db99acd892b01d7463",
			"secret_name": "FAUCET_URL"
		}
	],
	"services": [
		{
			"binding": "FAUCET",
			"service": "faucet"
		}
	]
}
