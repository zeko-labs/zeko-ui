{
	"markdown": {},
	"yaml": {
		"quotes": "forceDouble",
		"formatComments": true,
		"trailingComma": false
	},
	"excludes": [
		"**/node_modules",
		"**/.nuxt",
		"**/generated/*.d.ts",
		"**/worker-configuration.d.ts",
		".agents/skills/ataski/**",
		"pnpm-workspace.yaml",
		"pnpm-lock.yaml"
	],
	"plugins": [
		"https://plugins.dprint.dev/markdown-0.17.8.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.1.wasm"
	]
}
