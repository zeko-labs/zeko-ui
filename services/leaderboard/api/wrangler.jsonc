{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-10-08",
	"name": "leaderboard-api",
	"main": "src/index.ts",
	"preview_urls": true,
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"dev": { "port": 9000 },
	"vars": { "TOTAL_SHARDS": 5 },
	"routes": [{ "custom_domain": true, "pattern": "api.leaderboard.zeko.io" }],
	"durable_objects": {
		"bindings": [
			{ "name": "USER_DO", "class_name": "UserDo" },
			{ "name": "DISTRIBUTOR_DO", "class_name": "DistributorDO" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDo", "DistributorDO"] }],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "e93bc279913c4b549464d535ca9f0c6d",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5432/leaderboard"
		},
		{
			"binding": "HYPERDRIVE_NO_CACHE",
			"id": "b304d3ab823044d189cc332dfcc21ff6",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5432/leaderboard"
		}
	]
}
