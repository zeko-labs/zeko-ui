{
	"$schema": "../../../packages/cloudflare-build-config/schema/workers-build.schema.json",
	"scriptName": "actions-api",
	"triggers": [
		{
			"name": "Deploy default branch",
			"deployCommand": "echo 'Actions API deploys are owned by GitHub Actions; Cloudflare Workers Build deploy is disabled.'",
			"branchIncludes": ["main"],
			"branchExcludes": [],
			"pathIncludes": ["services/actions/api/**"],
			"pathExcludes": []
		},
		{
			"name": "Deploy non-production branches",
			"deployCommand": "echo 'Actions API preview deploys are disabled while env-specific GitHub Actions deploys own this Worker.'",
			"branchIncludes": ["*"],
			"branchExcludes": ["main"],
			"pathIncludes": ["services/actions/api/**"],
			"pathExcludes": []
		}
	]
}
