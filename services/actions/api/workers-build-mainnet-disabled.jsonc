{
	"$schema": "../../../packages/cloudflare-build-config/schema/workers-build.schema.json",
	"scriptName": "actions-api",
	"triggers": [
		{
			"name": "Deploy default branch",
			"deployCommand": "echo \"Automatic mainnet Actions API Workers Build is disabled; use the mainnet release workflow.\"",
			"branchIncludes": ["__disabled__"],
			"branchExcludes": [],
			"pathIncludes": ["__disabled__"],
			"pathExcludes": []
		},
		{
			"name": "Deploy non-production branches",
			"deployCommand": "echo \"Automatic mainnet Actions API preview Workers Build is disabled; use actions-api-testnet.\"",
			"branchIncludes": ["*"],
			"branchExcludes": ["main"],
			"pathIncludes": ["__disabled__"],
			"pathExcludes": []
		}
	]
}
