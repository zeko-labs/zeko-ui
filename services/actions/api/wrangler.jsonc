{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-10-08",
	"name": "actions-api",
	"main": "src/index.ts",
	"preview_urls": true,
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["zeko-traces"],
			"head_sampling_rate": 1,
			"persist": true
		},
		"logs": {
			"enabled": true,
			"destinations": ["zeko-logs"],
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"dev": { "port": 9100 },
	"vars": {
		"ENVIRONMENT": "mainnet"
	},
	"routes": [{ "custom_domain": true, "pattern": "api.actions.zeko.io" }],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE_NO_CACHE",
			"id": "REVIEW_REQUIRED_ACTIONS_MAINNET_DB_NO_CACHE_ID",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5434/actions"
		},
		{
			"binding": "HYPERDRIVE",
			"id": "REVIEW_REQUIRED_ACTIONS_MAINNET_DB_CACHE_ID",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5434/actions"
		}
	],
	"env": {
		"testnet": {
			"vars": {
				"ENVIRONMENT": "testnet"
			},
			"routes": [{ "custom_domain": true, "pattern": "testnet.api.actions.zeko.io" }],
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE_NO_CACHE",
					"id": "33ea9e81023146799e5658aae00731fc",
					"localConnectionString": "postgresql://postgres:postgres@localhost:5434/actions"
				},
				{
					"binding": "HYPERDRIVE",
					"id": "abf1ac369edf418ba9243099f96ead76",
					"localConnectionString": "postgresql://postgres:postgres@localhost:5434/actions"
				}
			]
		}
	}
}
