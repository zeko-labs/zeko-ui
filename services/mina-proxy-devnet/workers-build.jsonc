{
	"$schema": "../../../packages/cloudflare-build-config/schema/workers-build.schema.json",
	"scriptName": "mina-proxy-devnet",
	"triggers": [
		{
			"name": "Deploy default branch",
			"deployCommand": "./node_modules/.bin/moon exec --ignore-ci-checks mina-proxy-devnet:deploy",
			"branchIncludes": ["main"],
			"branchExcludes": [],
			"pathIncludes": ["services/mina-proxy-devnet/**"],
			"pathExcludes": []
		},
		{
			"name": "Deploy non-production branches",
			"deployCommand": "./node_modules/.bin/moon exec --ignore-ci-checks mina-proxy-devnet:deploy-preview",
			"branchIncludes": ["*"],
			"branchExcludes": ["main"],
			"pathIncludes": ["services/mina-proxy-devnet/**"],
			"pathExcludes": []
		}
	]
}
