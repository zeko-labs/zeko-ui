# Required bridge signer key.
ZEKO_BRIDGE_MINA_PRIVATE_KEY=

# Optional. Falls back to ZEKO_BRIDGE_MINA_PRIVATE_KEY when omitted.
ZEKO_BRIDGE_ZEKO_PRIVATE_KEY=

# Inngest Cloud app keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Slack bot delivery target.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional local server port.
PORT=3000
