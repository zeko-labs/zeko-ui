# Preferred dedicated validator signer key for the published CLI.
# The sync script maps this repo-root key into the Cloudflare WALLET_PRIVATE_KEY secret.
BRIDGE_VALIDATOR_WALLET_PRIVATE_KEY=
BRIDGE_VALIDATOR_WALLET_PUBLIC_KEY=

# Shared bridge signer key fallback.
ZEKO_BRIDGE_MINA_PRIVATE_KEY=

# If the repo root keeps multiple bridge wallets, the sync script falls back to _0 before _1.
ZEKO_BRIDGE_MINA_PRIVATE_KEY_0=
ZEKO_BRIDGE_MINA_PRIVATE_KEY_1=

# Backward-compatible alternative accepted by the sync script.
WALLET_PRIVATE_KEY=
WALLET_PUBLIC_KEY=

# Slack bot delivery target.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Bearer token required by the Worker HTTP endpoints.
VALIDATOR_API_TOKEN=

# Optional operator/runtime controls.
BRIDGE_VALIDATOR_BASE_URL=https://bridge-validator.zeko-labs.workers.dev
BRIDGE_VALIDATOR_ENABLED=true

# Optional PR validation path. When both source values are present, the sandbox
# clones and builds this source before running the bridge CLI.
BRIDGE_VALIDATOR_SOURCE_REPOSITORY=
BRIDGE_VALIDATOR_SOURCE_REF=
GITHUB_TOKEN=
