# Wallet secrets live in the repo-root .env.wallet.validator file by default.
# Override only when syncing from a different dedicated wallet file.
BRIDGE_VALIDATOR_WALLET_ENV_FILE=

# Slack bot delivery target.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Bearer token required by the Worker HTTP endpoints.
VALIDATOR_API_TOKEN=

# Optional operator/runtime controls.
BRIDGE_VALIDATOR_BASE_URL=https://bridge-validator.zeko-labs.workers.dev
BRIDGE_VALIDATOR_ENABLED=true

# Optional PR validation path. When both source values are present, the sandbox
# clones and builds this source before running the bridge CLI.
BRIDGE_VALIDATOR_SOURCE_REPOSITORY=
BRIDGE_VALIDATOR_SOURCE_REF=
GITHUB_TOKEN=
