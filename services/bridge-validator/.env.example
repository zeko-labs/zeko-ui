# Required shared bridge signer key for the published CLI.
# The sync script maps this repo-root key into the Cloudflare WALLET_PRIVATE_KEY secret.
ZEKO_BRIDGE_MINA_PRIVATE_KEY=

# Backward-compatible alternative accepted by the sync script.
WALLET_PRIVATE_KEY=

# Slack bot delivery target.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Bearer token required by the Worker HTTP endpoints.
VALIDATOR_API_TOKEN=

# Public Worker base URL used by workflow sandboxes for completion callbacks.
BRIDGE_VALIDATOR_BASE_URL=https://bridge-validator.zeko-labs.workers.dev
