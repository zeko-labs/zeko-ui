{
	"$schema": "../../../packages/cloudflare-build-config/schema/workers-build.schema.json",
	"scriptName": "bridge-validator",
	"triggers": [
		{
			"name": "Deploy default branch",
			"deployCommand": "./node_modules/.bin/moon exec --ignore-ci-checks bridge-validator:deploy",
			"branchIncludes": ["main"],
			"branchExcludes": [],
			"pathIncludes": [
				".moon/**",
				"moon.yml",
				"package.json",
				"patches/**",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml",
				"services/bridge-validator/**"
			],
			"pathExcludes": []
		}
	]
}
