{
	"display_information": {
		"name": "Zeko Bridge Validator",
		"description": "Posts bridge validation failures to Slack",
		"background_color": "#0f172a"
	},
	"features": {
		"bot_user": {
			"display_name": "Zeko Bridge Validator",
			"always_online": false
		}
	},
	"oauth_config": {
		"scopes": {
			"bot": ["chat:write", "channels:read", "groups:read"]
		}
	},
	"settings": {
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"is_hosted": false,
		"token_rotation_enabled": false
	}
}
