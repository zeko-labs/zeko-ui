{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"*.tsx",
			"*.jsx",
			"*.ts",
			"*.vue",
			"*.js",
			"*.mjs",
			"*.json",
			"*.jsonc",
			"*.css",
			"*.graphql",
			"*.gql",
			"*.html",
			"**/*.tsx",
			"**/*.jsx",
			"**/*.ts",
			"**/*.vue",
			"**/*.js",
			"**/*.mjs",
			"**/*.json",
			"**/*.jsonc",
			"**/*.css",
			"**/*.graphql",
			"**/*.gql",
			"**/*.html",
			"!node_modules",
			"!node_modules/**",
			"!**/node_modules",
			"!**/node_modules/**",
			"!**/worker-configuration.d.ts",
			"!**/graphql/*.d.ts",
			"!**/generated/*.d.ts",
			"!.agents/**",
			"!pnpm-lock.yaml",
			"settings.json"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"rules": {
			"suspicious": {
				"useIterableCallbackReturn": {
					"level": "warn"
				},
				"noUnknownAtRules": {
					"level": "error",
					"options": {
						"ignore": ["custom-media"]
					}
				}
			},
			"correctness": {
				"noUnusedImports": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"style": {
				"useConst": {
					"level": "warn",
					"fix": "safe"
				},
				"useNumberNamespace": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.vue"],
			"linter": {
				"enabled": true,
				"rules": {
					"a11y": {
						"useGenericFontNames": "warn",
						"noSvgWithoutTitle": "warn",
						"useButtonType": "warn"
					},
					"correctness": {
						"noUnusedVariables": {
							"level": "info",
							"fix": "none"
						},
						"noUnsafeOptionalChaining": "warn",
						"noUnknownMediaFeatureName": "info",
						"noUnknownFunction": "info",
						"noUnknownPseudoClass": "info",
						"noUnusedImports": {
							"level": "info",
							"fix": "none"
						}
					},
					"suspicious": {
						"noAssignInExpressions": "warn"
					},
					"nursery": {
						"noVueVOnNumberValues": "warn",
						"useVueNextTickPromise": "warn",
						"useVueValidVFor": "warn"
					}
				}
			}
		}
	],
	"html": {
		"experimentalFullSupportEnabled": true,
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"formatter": {
			"lineWidth": 150
		}
	},
	"json": {
		"formatter": {
			"expand": "auto",
			"lineWidth": 100
		}
	},
	"javascript": {
		"formatter": {
			"lineWidth": 100,
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	}
}
