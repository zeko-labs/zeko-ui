{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"ignore": ["**/generated/*.d.ts", "settings.json"],
		"rules": {
			"correctness": {
				"noUnusedImports": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"style": {
				"useConst": {
					"level": "warn",
					"fix": "safe"
				},
				"useNumberNamespace": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	}
}
